                                                                            owl:equivalentClass xsd:string .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/kdm/anschrift
:anschrift rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Betriebsstaette
                                       :JuristischePerson
                                       :NatuerlichePerson
                                       :RechtsfaehigePersonengesellschaft
                                       :SonstigePersonenvereinigung
                                       :WirtschaftlicheTaetigkeit
                                     )
                       ] ;
           rdfs:range :Anschrift ;
           rdfs:label "hat Anschrift"@de ;
           <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Anschrift einer wirtschaftlichen Tätigkeit, einer natürlichen Person, einer juristischen Person, einer rechtsfähigen Personengesellschaft oder einer sonstigen Personenvereinigung, ebenso einer Betriebsstätte einer wirtschaftlichen Tätigkeit."@de .


###  https://w3id.org/kdm/ansprechpartner
:ansprechpartner rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Antrag
                                             :Anzeige
                                           )
                             ] ;
                 rdfs:range :Ansprechpartner ;
                 rdfs:label "hat Ansprechpartner"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Ansprechpartner, welche das Kerndatenobjekt Natürliche Person einnehmen kann."@de .


###  https://w3id.org/kdm/ansprechpartnerID
:ansprechpartnerID rdf:type owl:ObjectProperty ;
                   rdfs:domain :Ansprechpartner ;
                   rdfs:range :NatuerlichePerson ;
                   rdfs:label "Ansprechpartner ist"@de ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die natürliche Person, die die Rolle des Ansprechpartners einnimmt."@de .


###  https://w3id.org/kdm/antragsteller
:antragsteller rdf:type owl:ObjectProperty ;
               rdfs:domain :Antrag ;
               rdfs:range :Antragsteller ;
               rdfs:label "hat Antragsteller"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Antragsteller, welche die Kerndatenobjekte Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft, Sonstige Personenvereinigung und Wirtschaftliche Tätigkeit einnehmen können."@de .


###  https://w3id.org/kdm/antragstellerID
:antragstellerID rdf:type owl:ObjectProperty ;
                 rdfs:domain :Antragsteller ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :JuristischePerson
                                            :NatuerlichePerson
                                            :RechtsfaehigePersonengesellschaft
                                            :SonstigePersonenvereinigung
                                            :WirtschaftlicheTaetigkeit
                                          )
                            ] ;
                 rdfs:label "Antragsteller ist"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft, Sonstige Personenvereinigung oder Wirtschaftliche Tätigkeit, die die Rolle des Antragstellers einnehmen."@de .


###  https://w3id.org/kdm/anzeigender
:anzeigender rdf:type owl:ObjectProperty ;
             rdfs:domain :Anzeige ;
             rdfs:range :Anzeigender ;
             rdfs:label "hat Anzeigenden"@de ;
             <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Anzeigender."@de .


###  https://w3id.org/kdm/anzeigenderID
:anzeigenderID rdf:type owl:ObjectProperty ;
               rdfs:domain :Anzeigender ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :JuristischePerson
                                          :NatuerlichePerson
                                          :RechtsfaehigePersonengesellschaft
                                          :SonstigePersonenvereinigung
                                          :WirtschaftlicheTaetigkeit
                                        )
                          ] ;
               rdfs:label "Anzeigender ist"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft, Sonstige Personenvereinigung oder Wirtschaftliche Tätigkeit, die die Rolle des Anzeigenden einnehmen."@de .


###  https://w3id.org/kdm/beteiligter
:beteiligter rdf:type owl:ObjectProperty ;
             rdfs:domain :RechtsfaehigePersonengesellschaft ;
             rdfs:range :Beteiligter ;
             rdfs:label "hat Beteiligten"@de ;
             <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Beteiligter, welche das Kerndatenobjekt Natürliche Person einnehmen kann. Mit dieser Rolle wird ein Beteiligter einer sonstigen Personenvereinigung gefasst."@de .


###  https://w3id.org/kdm/beteiligterID
:beteiligterID rdf:type owl:ObjectProperty ;
               rdfs:domain :Beteiligter ;
               rdfs:range :NatuerlichePerson ;
               rdfs:label "Beteiligter ist"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die natürliche Person, die die Rolle des Beteiligten einnimmt."@de .


###  https://w3id.org/kdm/betriebsstaette
:betriebsstaette rdf:type owl:ObjectProperty ;
                 rdfs:domain :WirtschaftlicheTaetigkeit ;
                 rdfs:range :Betriebsstaette ;
                 rdfs:label "hat Betriebsstätte"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Betriebsstätte einer wirtschaftlichen Tätigkeit."@de .


###  https://w3id.org/kdm/demail
:demail rdf:type owl:ObjectProperty ;
        rdfs:domain :Kommunikation ;
        rdfs:range :Demail ;
        rdfs:label "hat De-Mail"@de ;
        <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Angaben zur Erreichbarkeit per De-Mail."@de .


###  https://w3id.org/kdm/effektiverVerwaltungssitz
:effektiverVerwaltungssitz rdf:type owl:ObjectProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :JuristischePerson
                                                       :RechtsfaehigePersonengesellschaft
                                                       :SonstigePersonenvereinigung
                                                     )
                                       ] ;
                           rdfs:range :EffektiverVerwaltungssitz ;
                           rdfs:label "hat effektiven Verwaltungssitz"@de ;
                           <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Effektiver Verwaltungssitz einer juristischen Person, einer rechtsfähigen Personengesellschaft oder einer sonstigen Personenvereinigung."@de .


###  https://w3id.org/kdm/eintragung
:eintragung rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :JuristischePerson
                                        :RechtsfaehigePersonengesellschaft
                                        :SonstigePersonenvereinigung
                                        :WirtschaftlicheTaetigkeit
                                      )
                        ] ;
            rdfs:range :Eintragung ;
            rdfs:label "hat Eintragung"@de ;
            <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Eintragung einer Wirtschaftlichen Tätigkeit, einer Juristischen Person, einer Rechtsfähigen Personengesellschaft oder einer Sonstigen Personenvereinigung."@de .


###  https://w3id.org/kdm/email
:email rdf:type owl:ObjectProperty ;
       rdfs:domain :Kommunikation ;
       rdfs:range :Email ;
       rdfs:label "hat E-Mail"@de ;
       <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Angaben zur Erreichbarkeit per E-Mail."@de .


###  https://w3id.org/kdm/geburt
:geburt rdf:type owl:ObjectProperty ;
        rdfs:domain :NatuerlichePerson ;
        rdfs:range :Geburt ;
        rdfs:label "hat Geburt"@de ;
        <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Geburt einer natürlichen Person."@de .


###  https://w3id.org/kdm/gesellschafter
:gesellschafter rdf:type owl:ObjectProperty ;
                rdfs:domain :Personengesellschaft ;
                rdfs:range :Gesellschafter ;
                rdfs:label "hat Gesellschafter"@de ;
                <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Gesellschafter, welche die Kerndatenobjekte Natürliche Person, Juristische Person und Rechtsfähige Personengesellschaft einnehmen können."@de .


###  https://w3id.org/kdm/gesellschafterID
:gesellschafterID rdf:type owl:ObjectProperty ;
                  rdfs:domain :Gesellschafter ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( :JuristischePerson
                                             :NatuerlichePerson
                                             :RechtsfaehigePersonengesellschaft
                                           )
                             ] ;
                  rdfs:label "Gesellschafter ist"@de ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die natürliche Person, Jjuristische Person oder rechtsfähige Personengesellschaft, die die Rolle des Gesellschafters einnehmen."@de .


###  https://w3id.org/kdm/gesetzlicherVertreter
:gesetzlicherVertreter rdf:type owl:ObjectProperty ;
                       rdfs:domain :GesetzlicherVertreter ,
                                   [ rdf:type owl:Class ;
                                     owl:unionOf ( :JuristischePerson
                                                   :NatuerlichePerson
                                                 )
                                   ] ;
                       rdfs:label "hat gesetzlichen Vertreter"@de ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Gesetzlicher Vertreter, welche die Kerndatenobjekte Natürliche Person und Juristische Person einnehmen können."@de .


###  https://w3id.org/kdm/gesetzlicherVertreterID
:gesetzlicherVertreterID rdf:type owl:ObjectProperty ;
                         rdfs:domain :GesetzlicherVertreter ;
                         rdfs:range [ rdf:type owl:Class ;
                                      owl:unionOf ( :JuristischePerson
                                                    :NatuerlichePerson
                                                  )
                                    ] ;
                         rdfs:label "Gesetzlicher Vertreter ist"@de ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die natürliche Person oder die juristische Person, die die Rolle des gesetzlichen Vertreters einnehmen."@de .


###  https://w3id.org/kdm/handelndePerson
:handelndePerson rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Antrag
                                             :Anzeige
                                           )
                             ] ;
                 rdfs:range :HandelndePerson ;
                 rdfs:label "hat handelnde Person"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Handelnde Person, welche die Kerndatenobjekte Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft, Sonstige Personenvereinigung und Wirtschaftliche Tätigkeit einnehmen können."@de .


###  https://w3id.org/kdm/handelndePersonID
:handelndePersonID rdf:type owl:ObjectProperty ;
                   rdfs:domain :HandelndePerson ;
                   rdfs:range :NatuerlichePerson ;
                   rdfs:label "Handelnde Person ist"@de ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die natürliche Person, die die Rolle der handelnden Person einnimmt."@de .


###  https://w3id.org/kdm/kommunikation
:kommunikation rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Betriebsstaette
                                           :JuristischePerson
                                           :NatuerlichePerson
                                           :RechtsfaehigePersonengesellschaft
                                           :SonstigePersonenvereinigung
                                           :WirtschaftlicheTaetigkeit
                                         )
                           ] ;
               rdfs:range :Kommunikation ;
               rdfs:label "hat Kommunikation"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Kommunikation einer wirtschaftlichen Tätigkeit, einer natürlichen Person, einer juristischen Person, einer rechtsfähigen Personengesellschaft oder einer sonstigen Personenvereinigung, ebenso einer Betriebsstätte einer wirtschaftlichen Tätigkeit."@de .


###  https://w3id.org/kdm/nameEinerNatuerlichenPerson
:nameEinerNatuerlichenPerson rdf:type owl:ObjectProperty ;
                             rdfs:domain :NatuerlichePerson ;
                             rdfs:range :NameEinerNatuerlichenPerson ;
                             rdfs:label "hat Namen"@de ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Name einer natürlichen Person."@de .


###  https://w3id.org/kdm/sitz
:sitz rdf:type owl:ObjectProperty ;
      rdfs:domain [ rdf:type owl:Class ;
                    owl:unionOf ( :JuristischePerson
                                  :RechtsfaehigePersonengesellschaft
                                  :SonstigePersonenvereinigung
                                )
                  ] ;
      rdfs:range :Sitz ;
      rdfs:label "hat Sitz"@de ;
      <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Sitz einer juristischen Person, einer rechtsfähigen Personengesellschaft oder einer sonstigen Personenvereinigung."@de .


###  https://w3id.org/kdm/telefax
:telefax rdf:type owl:ObjectProperty ;
         rdfs:domain :Kommunikation ;
         rdfs:range :Telefax ;
         rdfs:label "hat Telefax"@de ;
         <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Angaben zur Erreichbarkeit per Telefax."@de .


###  https://w3id.org/kdm/telefon
:telefon rdf:type owl:ObjectProperty ;
         rdfs:domain :Kommunikation ;
         rdfs:range :Telefon ;
         rdfs:label "hat Telefon"@de ;
         <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Angaben zur telefonischen Erreichbarkeit."@de .


###  https://w3id.org/kdm/web
:web rdf:type owl:ObjectProperty ;
     rdfs:domain :Kommunikation ;
     rdfs:range :WebAdresse ;
     rdfs:label "hat Web-Adresse"@de ;
     <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Angaben zur Erreichbarkeit per Web-Adresse."@de .


###  https://w3id.org/kdm/wirtschaftlichTaetiger
:wirtschaftlichTaetiger rdf:type owl:ObjectProperty ;
                        rdfs:domain :WirtschaftlicheTaetigkeit ;
                        rdfs:range :WirtschaftlichTaetiger ;
                        rdfs:label "hat Wirtschaftlich Tätigen"@de ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ein Verweis auf die Rolle Wirtschaftlich Tätiger, welche die Kerndatenobjekte Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft und Sonstige Personenvereinigung einnehmen können."@de .


###  https://w3id.org/kdm/wirtschaftlichTaetigerID
:wirtschaftlichTaetigerID rdf:type owl:ObjectProperty ;
                          rdfs:domain :WirtschaftlichTaetiger ;
                          rdfs:range [ rdf:type owl:Class ;
                                       owl:unionOf ( :JuristischePerson
                                                     :NatuerlichePerson
                                                     :RechtsfaehigePersonengesellschaft
                                                     :SonstigePersonenvereinigung
                                                   )
                                     ] ;
                          rdfs:label "Wirtschaftlich Tätiger ist"@de ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Diese Eigenschaft dient dem Verweis auf die natürliche Person, juristische Person, rechtsfähige Personengesellschaft oder sonstige Personenvereinigung, die die Rolle des Wirtschaftlich Tätigen einnehmen."@de .


###  https://w3id.org/kdm/wirtschaftszweig
:wirtschaftszweig rdf:type owl:ObjectProperty ;
                  rdfs:domain :WirtschaftlicheTaetigkeit ;
                  rdfs:range :Wirtschaftszweig ;
                  rdfs:label "hat Wirtschaftszweig"@de ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Verweis auf das Datenobjekt Wirtschaftszweig einer wirtschaftlichen Tätigkeit."@de .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/kdm/artAngabeAntragstellerAnzeigenderCode
:artAngabeAntragstellerAnzeigenderCode rdf:type owl:DatatypeProperty ;
                                       rdfs:domain [ rdf:type owl:Class ;
                                                     owl:unionOf ( :Antragsteller
                                                                   :Anzeigender
                                                                 )
                                                   ] ;
                                       rdfs:range <urn:xoev-de:xunternehmen:codeliste:angabeantragstelleranzeigender> ;
                                       rdfs:label "Art der Angabe des Antragstellers oder des Anzeigenden"@de ;
                                       rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:angabeantragstelleranzeigender> ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Angabe der Angabenart des Antragstellers oder des Anzeigenden in einem Antrag oder einer Anzeige. Hier wird angegeben, ob die natürliche oder juristische Person bzw. die rechtsfähige Personengesellschaft des Anzeigenden explizit angegeben wird oder ob lediglich seine wirtschaftliche Tätigkeit angegeben wird und der Anzeigende damit implizit bestimmt ist."@de .


###  https://w3id.org/kdm/artAnschriftCode
:artAnschriftCode rdf:type owl:DatatypeProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :AnschriftAusland
                                              :AnschriftInlandGrossempfaengeranschrift
                                              :AnschriftInlandPostfachanschrift
                                              :AnschriftInlandStrassenanschrift
                                            )
                              ] ;
                  rdfs:range <urn:xoev-de:xunternehmen:codeliste:artanschrift> ;
                  rdfs:label "Art der Anschrift"@de ;
                  rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artanschrift> ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Angabe der Rolle oder Funktion einer Anschrift, z. B. einer Geschäftsanschrift oder Wohnsitzadresse."@de .


###  https://w3id.org/kdm/artBetriebsstaetteCode
:artBetriebsstaetteCode rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Betriebsstaette ;
                        rdfs:range <urn:xoev-de:xunternehmen:codeliste:artniederlassung> ;
                        rdfs:label "Art der Betriebsstätte"@de ;
                        rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artniederlassung> ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Nähere Bestimmung der Art der Betriebsstätte. Die möglichen Ausprägungen dieses Attributes sind durch die Codeliste Art einer Niederlassung (https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artniederlassung) im XRepository bestimmt."@de .


###  https://w3id.org/kdm/artEintragungCode
:artEintragungCode rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Eintragung ;
                   rdfs:range <urn:xoev-de:xunternehmen:codeliste:artdereintragung> ;
                   rdfs:label "Art der Eintragung"@de ;
                   rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artdereintragung> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Angabe der Art des Registers, in welchem ein wirtschaftlich Tätiger bzw. eine wirtschaftliche Tätigkeit geführt wird."@de .


###  https://w3id.org/kdm/artGesellschafterCode
:artGesellschafterCode rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Gesellschafter ;
                       rdfs:range <urn:xoev-de:xunternehmen:codeliste:artgesellschafterpersonengesellschaft> ;
                       rdfs:label "Art des Gesellschafters"@de ;
                       rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artgesellschafterpersonengesellschaft> ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Angabe der Art eines Gesellschafters einer Personengesellschaft"@de ;
                       <http://www.w3.org/2004/02/skos/core#note> "Hier ist der Codelistenwert der Codeliste Art des Gesellschafters (https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artgesellschafterpersonengesellschaft) anzugeben, beispielsweise 02 für einen persönlich haftenden Gesellschafter."@de .


###  https://w3id.org/kdm/artGesetzlicherVertreterCode
:artGesetzlicherVertreterCode rdf:type owl:DatatypeProperty ;
                              rdfs:domain :GesetzlicherVertreter ;
                              rdfs:range <urn:xoev-de:xunternehmen:codeliste:artgesetzlichervertreter> ;
                              rdfs:label "Art des Gesetzlichen Vertreters"@de ;
                              rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artgesetzlichervertreter> ;
                              <http://www.w3.org/2004/02/skos/core#definition> "Angabe der Art des Gesetzlichen Vertreters."@de ;
                              <http://www.w3.org/2004/02/skos/core#note> "Hier ist der Codelistenwert (= String) der Codeliste Art des Gesetzlichen Vertreters (https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:artgesetzlichervertreter) anzugeben, beispielsweise 3 für Vorstand."@de .


###  https://w3id.org/kdm/bundeseinheitlicheWirtschaftsnummer
:bundeseinheitlicheWirtschaftsnummer rdf:type owl:DatatypeProperty ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( :JuristischePerson
                                                                 :RechtsfaehigePersonengesellschaft
                                                                 :SonstigePersonenvereinigung
                                                                 :WirtschaftlicheTaetigkeit
                                                               )
                                                 ] ;
                                     rdfs:range xsd:string ;
                                     rdfs:label "Bundeseinheitliche Wirtschaftsnummer"@de ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Angabe der bundeseinheitlichen Wirtschaftsnummer für Unternehmen gemäß § 2 UBRegG."@de .


###  https://w3id.org/kdm/demailadresse
:demailadresse rdf:type owl:DatatypeProperty ;
               rdfs:domain :Demail ;
               rdfs:range xsd:string ;
               rdfs:label "De-Mail-Adresse"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "De-Mail-Adresse, strukturiert gemäß BSI TR-01201 De-Mail. Beispiel: erika.mustermann@mustermann.de-mail.de."@de .


###  https://w3id.org/kdm/doktorgrad
:doktorgrad rdf:type owl:DatatypeProperty ;
            rdfs:domain :NatuerlichePerson ;
            rdfs:range xsd:string ;
            rdfs:label "Doktorgrad"@de ;
            <http://www.w3.org/2004/02/skos/core#definition> "Es sind nur diejenigen Doktorgrade anzugeben, die in Pässe eingetragen werden dürfen. Sind mehrere Doktorgrade anzugeben, so sind sie durch ein Leerzeichen zu trennen."@de .


###  https://w3id.org/kdm/eingetragenerName
:eingetragenerName rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :JuristischePerson
                                               :RechtsfaehigePersonengesellschaft
                                               :SonstigePersonenvereinigung
                                               :WirtschaftlicheTaetigkeit
                                             )
                               ] ;
                   rdfs:range xsd:string ;
                   rdfs:label "eingetragenen Namen"@de ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Die im Handels-, Genossenschafts- oder Gesellschaftsregister eingetragene Firma eines wirtschaftlich Tätigen oder einer wirtschaftlichen Tätigkeit (z. B. eingetragenes Einzelunternehmen, eingetragene Zweigniederlassung) bzw. der im Vereins-, Partnerschafts- oder Stiftungsregister oder im Stiftungsverzeichnis eingetragene Name."@de .


###  https://w3id.org/kdm/eintragungsnummer
:eintragungsnummer rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Eintragung ;
                   rdfs:range xsd:string ;
                   rdfs:label "Eintragungsnummer"@de ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Nummer der Eintragung im jeweiligen Register bzw. Aktenzeichen im Stiftungsverzeichnis. Sofern zum Zwecke der Eindeutigkeit der Eintragungsnummer im angegebenen Register ein Ortskennzeichen verwendet wird, wird dieses ebenfalls, durch Leerzeichen getrennt, in diesem Attribut angegeben (Beispiele: 12345 KI, 12345 FL)."@de .


###  https://w3id.org/kdm/emailadresse
:emailadresse rdf:type owl:DatatypeProperty ;
              rdfs:domain :Email ;
              rdfs:range xsd:string ;
              rdfs:label "E-Mail-Adresse"@de ;
              <http://www.w3.org/2004/02/skos/core#definition> "E-Mail-Adresse."@de .


###  https://w3id.org/kdm/familienname
:familienname rdf:type owl:DatatypeProperty ;
              rdfs:domain :NameEinerNatuerlichenPerson ;
              rdfs:range xsd:string ;
              rdfs:label "Familienname"@de ;
              <http://www.w3.org/2004/02/skos/core#definition> "Familienname einer natürlichen Person bestehend aus Nachname, Zuname bzw. Familienname."@de .


###  https://w3id.org/kdm/familiennameNichtVorhanden
:familiennameNichtVorhanden rdf:type owl:DatatypeProperty ;
                            rdfs:domain :NameEinerNatuerlichenPerson ;
                            rdfs:range xsd:boolean ;
                            rdfs:label "Familienname nicht vorhanden"@de ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Angabe, dass die betreffende Person keinen Familiennamen führt."@de .


###  https://w3id.org/kdm/fruehererGemeindename
:fruehererGemeindename rdf:type owl:DatatypeProperty ;
                       rdfs:domain :AnschriftInlandStrassenanschrift ;
                       rdfs:range xsd:string ;
                       rdfs:label "Früherer Gemeindename"@de ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Der frühere Gemeindename, der als Stadt- bzw. Ortsteilname dem jetzigen Gemeindenamen hinzugefügt wird. Der frühere Gemeindename (jetziger Ortsteil- oder Stadtteilname) ist bei Adressierungen unterhalb des Namens (oberhalb der Straßenbezeichnung) anzugeben."@de .


###  https://w3id.org/kdm/geburtsdatum
:geburtsdatum rdf:type owl:DatatypeProperty ;
              rdfs:domain :Geburt ;
              rdfs:range xsd:string ;
              rdfs:comment "Die Datumsangabe per xsd:date, xsd:gYear oder xsd:gYearMonth ist im Format zu restriktiv, da an dieser Stelle im XUnternehmen.Kerndatenmodell keine Beschränkungen gemacht werden bzw. auf eine deutsche Datumgsangabe zurückzugreifen ist."@de ;
              rdfs:label "Geburtsdatum"@de ;
              <http://www.w3.org/2004/02/skos/core#definition> "Datum der Vollendung der Geburt. Diese Angabe ist als teilbekannte Datumsangabe zu machen. Eine teilbekannte Datumsangabe umfasst die Komponenten Tag, Monat und Jahr, die Komponenten Monat und Jahr oder nur die Komponente Jahr."@de .


###  https://w3id.org/kdm/geburtsname
:geburtsname rdf:type owl:DatatypeProperty ;
             rdfs:domain :NameEinerNatuerlichenPerson ;
             rdfs:range xsd:string ;
             rdfs:label "Geburtsname"@de ;
             <http://www.w3.org/2004/02/skos/core#definition> "Der Geburtsname entspricht dem Familiennamen einer natürlichen Person vor der Schließung der ersten Ehe bzw. vor dem Eingehen der ersten Lebenspartnerschaft."@de .


###  https://w3id.org/kdm/geburtsnameNichtVorhanden
:geburtsnameNichtVorhanden rdf:type owl:DatatypeProperty ;
                           rdfs:domain :NameEinerNatuerlichenPerson ;
                           rdfs:range xsd:boolean ;
                           rdfs:label "Geburtsname nicht vorhanden"@de ;
                           <http://www.w3.org/2004/02/skos/core#definition> "Angabe, dass vor der Eheschließung oder vor der Begründung der Lebenspartnerschaft nach dem für die Namensführung maßgebenden Recht kein Familienname vorhanden gewesen ist."@de .


###  https://w3id.org/kdm/gemeindeschluesselCode
:gemeindeschluesselCode rdf:type owl:DatatypeProperty ;
                        rdfs:domain :AnschriftInlandStrassenanschrift ;
                        rdfs:range <urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:ags> ;
                        rdfs:label "Gemeindeschlüssel"@de ;
                        rdfs:seeAlso <https://www.xrepository.de/details/urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:ags> ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Der vom Statistischen Bundesamt herausgegebene bundeseinheitliche Gemeindeschlüssel der Gemeinde, in welcher die Anschrift liegt."@de .


###  https://w3id.org/kdm/geschaeftsbezeichnung
:geschaeftsbezeichnung rdf:type owl:DatatypeProperty ;
                       rdfs:domain :WirtschaftlicheTaetigkeit ;
                       rdfs:range xsd:string ;
                       rdfs:label "Geschäftsbezeichnung"@de ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Im Geschäftsverkehr einer wirtschaftlichen Tätigkeit verwendeter Name. Dieser kann abweichen von einem ggf. im Handel-, Genossenschafts-, Gesellschafts-, Partnerschafts- oder Vereinsregister eingetragen Namen."@de .


###  https://w3id.org/kdm/geschlechtCode
:geschlechtCode rdf:type owl:DatatypeProperty ;
                rdfs:domain :NatuerlichePerson ;
                rdfs:range <urn:xoev-de:xinneres:codeliste:geschlecht> ;
                rdfs:label "Geschlecht"@de ;
                rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xinneres:codeliste:geschlecht> ;
                <http://www.w3.org/2004/02/skos/core#definition> "Als Geschlechtsangabe zulässig sind: männlich, weiblich, divers, keine Angabe."@de .


###  https://w3id.org/kdm/hausnummer
:hausnummer rdf:type owl:DatatypeProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :AnschriftAusland
                                        :AnschriftInlandStrassenanschrift
                                      )
                        ] ;
            rdfs:range xsd:string ;
            rdfs:label "Hausnummer"@de ;
            <http://www.w3.org/2004/02/skos/core#definition> "Die vollständige Hausnummer, ggf. inkl. Buchstabe/Zusatzziffern und Teilnummer."@de .


###  https://w3id.org/kdm/identifikationsnummer
:identifikationsnummer rdf:type owl:DatatypeProperty ;
                       rdfs:domain :NatuerlichePerson ;
                       rdfs:range xsd:string ;
                       rdfs:label "Identifikationsnummer"@de ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Identifikationsnummer einer natürlichen Person gemäß IDNrG."@de .


###  https://w3id.org/kdm/klassifikationKommunikationCode
:klassifikationKommunikationCode rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :Kommunikation ;
                                 rdfs:range <urn:xoev-de:xunternehmen:codeliste:klassifikationkommunikation> ;
                                 rdfs:label "Klassifikation der Kommunikationsangabe"@de ;
                                 rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:klassifikationkommunikation> ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Eine Klassifikation der Kommunikationsangabe (privat, geschäftlich, ...)."@de .


###  https://w3id.org/kdm/kommunikationHinweis
:kommunikationHinweis rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Kommunikation ;
                      rdfs:range xsd:string ;
                      rdfs:label "Hinweis zur Kommunikation"@de ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Ein ergänzender Hinweis zur Verwendung dieser Kommunikationsangabe."@de .


###  https://w3id.org/kdm/ort
:ort rdf:type owl:DatatypeProperty ;
     rdfs:domain [ rdf:type owl:Class ;
                   owl:unionOf ( :AnschriftAusland
                                 :AnschriftInlandGrossempfaengeranschrift
                                 :AnschriftInlandPostfachanschrift
                                 :AnschriftInlandStrassenanschrift
                                 :EffektiverVerwaltungssitz
                                 :Eintragung
                                 :Sitz
                               )
                 ] ;
     rdfs:range xsd:string ;
     rdfs:label "Ort"@de ;
     <http://www.w3.org/2004/02/skos/core#definition> "Der Name des Ortes (Gemeinde, Ortschaft oder Stadt)."@de .


###  https://w3id.org/kdm/ortDerGeburt
:ortDerGeburt rdf:type owl:DatatypeProperty ;
              rdfs:domain :Geburt ;
              rdfs:range xsd:string ;
              rdfs:label "Ort der Geburt"@de ;
              <http://www.w3.org/2004/02/skos/core#definition> "Der Ort der Geburt einer natürlichen Person."@de .


###  https://w3id.org/kdm/postfach
:postfach rdf:type owl:DatatypeProperty ;
          rdfs:domain :AnschriftInlandGrossempfaengeranschrift ;
          rdfs:range xsd:string ;
          rdfs:label "Postfach"@de ;
          <http://www.w3.org/2004/02/skos/core#definition> "Ein Postfach (oft Postfachnummer) ist ein Schlüssel zur Identifikation eines Postfaches in einer Postfiliale."@de .


###  https://w3id.org/kdm/postleitzahl
:postleitzahl rdf:type owl:DatatypeProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :AnschriftAusland
                                          :AnschriftInlandGrossempfaengeranschrift
                                          :AnschriftInlandPostfachanschrift
                                          :AnschriftInlandStrassenanschrift
                                        )
                          ] ;
              rdfs:range xsd:string ;
              rdfs:label "Postleitzahl"@de ;
              <http://www.w3.org/2004/02/skos/core#definition> "Es ist die Postleitzahl anzugeben."@de .


###  https://w3id.org/kdm/rechtsformenCode
:rechtsformenCode rdf:type owl:DatatypeProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :JuristischePerson
                                              :RechtsfaehigePersonengesellschaft
                                              :SonstigePersonenvereinigung
                                              :WirtschaftlicheTaetigkeit
                                            )
                              ] ;
                  rdfs:range <urn:xoev-de:xunternehmen:codeliste:rechtsformen> ;
                  rdfs:label "Rechtsform"@de ;
                  rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:rechtsformen> ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Die Codeliste der Rechtsformen bildet ab Version 2 fachbereichsübergreifend Anforderungen an die Codierung von Rechtsforminformationen ab und ermöglicht deren bereichsübergreifend einheitliche Codierung und Übermittlung. Aktuell werden die Anforderungen aus dem Grundinformationsdienst GINSTER der Steuerverwaltung und damit auch der Codierung im ELSTER-Unternehmenskonto, aus dem Registerportal der Handels-, Genossenschafts-, Partnerschafts- und Vereinsregister, dem Standard XGewerbeanzeige / XGewerbeordnung und damit auch dem Unternehmerverzeichnis der gesetzlichen Unfallversicherung umgesetzt. Auf diese Weise können beispielweise Rechtsforminformationen ohne semantische Brüche aus dem ELSTER-Unternehmenskonto über einen Online-Dienst zur Gewerbeanmeldung an die zuständige Gewerbebehörde übermittelt werden und dort mit Daten aus dem Registerportal der Justiz und (perspektivisch) mit dem Basisregister gemäß UBRegG zusammengeführt werden. Seit Version 2 sind die Codes sechsstellig und hierarchisch gegliedert, um unterschiedliche Granularitäten der Rechtsformdifferenzierung zu unterstützen und Codes einfacher zueinander in Bezug setzen zu können. Die Version 2 der Rechtsformcodierung ist vollständig rückwärtskompatibel zur Version 1 in dem Sinne, dass eine Eins-zu-eins-Umschlüsselung der bisherigen Codes erfolgen kann."@de .


###  https://w3id.org/kdm/registergerichtBezeichnung
:registergerichtBezeichnung rdf:type owl:DatatypeProperty ;
                            rdfs:domain :Eintragung ;
                            rdfs:range xsd:string ;
                            rdfs:label "Bezeichnung Registergericht"@de ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Bezeichnung des Registergerichts, in dessen Register der wirtschaftlich Tätige bzw. die wirtschaftliche Tätigkeit (z. B. Zweigniederlassung) geführt wird."@de .


###  https://w3id.org/kdm/registergerichtCode
:registergerichtCode rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Eintragung ;
                     rdfs:range <urn:xoev-de:xunternehmen:codeliste:registergerichte> ;
                     rdfs:label "Registergericht Code"@de ;
                     rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:registergerichte> ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Schlüssel des Registergerichts, in dessen Register der wirtschaftlich Tätige bzw. die wirtschaftliche Tätigkeit (z. B. Zweigniederlassung) geführt wird."@de .


###  https://w3id.org/kdm/staat
:staat rdf:type owl:DatatypeProperty ;
       rdfs:domain [ rdf:type owl:Class ;
                     owl:unionOf ( :AnschriftAusland
                                   :EffektiverVerwaltungssitz
                                   :Eintragung
                                   :Geburt
                                   :Sitz
                                 )
                   ] ;
       rdfs:range xsd:string ;
       <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:staat" ;
       rdfs:label "Staat"@de ;
       rdfs:seeAlso <https://www.destatis.de/DE/Methoden/Klassifikationen/Staat-Gebietsystematik/staatsangehoerigkeit-gebietsschluessel.html> ,
                    <https://www.iso.org/obp/ui/#search> ;
       <http://www.w3.org/2004/02/skos/core#definition> "Angabe eines Staats oder eines Staatsgebiets. Je nach fachlichem und rechtlichem Kontext bzw. dem jeweiligen Ziel der Datenerhebung kann diese Angabe mit unterschiedlich umfangreichen und unterschiedlich fein aufgelösten Codelisten codiert werden. Der Standard XUnternehmen.Kerndatenmodell gibt entsprechend keine einheitliche Codeliste vor, sondern lässt die Verwendung unterschiedlicher Codelisten, im Wesentlichen aus der Staats- und Gebietssystematik (BEV) des Statistischen Bundesamts zu."@de .


###  https://w3id.org/kdm/staatsangehoerigkeitCode
:staatsangehoerigkeitCode rdf:type owl:DatatypeProperty ;
                          rdfs:domain :NatuerlichePerson ;
                          rdfs:range <urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:staatsangehoerigkeit> ;
                          rdfs:label "Staatsangehörigkeit Code"@de ;
                          rdfs:seeAlso <https://www.xrepository.de/details/urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:staatsangehoerigkeit> ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Die Staatsangehörigkeit der natürlichen Person gemäß Codierung des statistischen Bundesamts."@de .


###  https://w3id.org/kdm/stiftungsverzeichnis
:stiftungsverzeichnis rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Eintragung ;
                      rdfs:range xsd:string ;
                      rdfs:label "Stiftungsverzeichnis in"@de ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Bei Einträgen im Stiftungsverzeichnis: Angabe des Bundeslandes bzw. der Behörde, in dessen oder deren Stiftungsverzeichnis der Eintrag geführt wird."@de .


###  https://w3id.org/kdm/strasse
:strasse rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :AnschriftAusland
                                     :AnschriftInlandStrassenanschrift
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:label "Straße"@de ;
         <http://www.w3.org/2004/02/skos/core#definition> "Es ist die Bezeichnung der Straße anzugeben."@de .


###  https://w3id.org/kdm/taetigkeit
:taetigkeit rdf:type owl:DatatypeProperty ;
            rdfs:domain :WirtschaftlicheTaetigkeit ;
            rdfs:range xsd:string ;
            rdfs:label "Tätigkeit"@de ;
            <http://www.w3.org/2004/02/skos/core#definition> "Benennung bzw. Bezeichnung der ausgeübten Tätigkeit."@de .


###  https://w3id.org/kdm/telefaxnummer
:telefaxnummer rdf:type owl:DatatypeProperty ;
               rdfs:domain :Telefax ;
               rdfs:range xsd:string ;
               rdfs:label "Telefaxnummer"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Telefaxnummer, strukturiert gemäß ITU E.123. Beispiel: +49 421 1234567, +49 421 123 4567, (0421) 1234567. Die Angabe soll möglichst gemäß DIN 5008 aufgebaut sein."@de .


###  https://w3id.org/kdm/telefonnummer
:telefonnummer rdf:type owl:DatatypeProperty ;
               rdfs:domain :Telefon ;
               rdfs:range xsd:string ;
               rdfs:label "Telefonnummer"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Telefonnummer, strukturiert gemäß ITU E.123. Beispiel: +49 421 1234567, +49 421 123 4567, (0421) 1234567. Die Angabe soll möglichst gemäß DIN 5008 aufgebaut sein."@de .


###  https://w3id.org/kdm/versionWirtschaftszweigschluesselCode
:versionWirtschaftszweigschluesselCode rdf:type owl:DatatypeProperty ;
                                       rdfs:domain :Wirtschaftszweig ;
                                       rdfs:range <urn:xoev-de:xunternehmen:codeliste:wirtschaftszweigklassifikationsversion> ;
                                       rdfs:label "Version der Wirtschaftszweigklassifikation"@de ;
                                       rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:codeliste:wirtschaftszweigklassifikationsversion> ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Version der Klassifikation der Wirtschaftszweige, bspw. WZ-2008. Die möglichen Ausprägungen dieses Attributes sind durch die Codeliste Wirtschaftszweigklassifikation im XRepository bestimmt."@de .


###  https://w3id.org/kdm/vornamen
:vornamen rdf:type owl:DatatypeProperty ;
          rdfs:domain :NameEinerNatuerlichenPerson ;
          rdfs:range xsd:string ;
          rdfs:label "Vornamen"@de ;
          <http://www.w3.org/2004/02/skos/core#definition> "Vornamen einer natürlichen Person."@de .


###  https://w3id.org/kdm/vornamenNichtVorhanden
:vornamenNichtVorhanden rdf:type owl:DatatypeProperty ;
                        rdfs:domain :NameEinerNatuerlichenPerson ;
                        rdfs:range xsd:boolean ;
                        rdfs:label "Geburtsname nicht vorhanden"@de ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Angabe, dass die betreffende Person keinen Vornamen führt."@de .


###  https://w3id.org/kdm/webadresse
:webadresse rdf:type owl:DatatypeProperty ;
            rdfs:domain :WebAdresse ;
            rdfs:range xsd:string ;
            rdfs:label "Web-Adresse"@de ;
            <http://www.w3.org/2004/02/skos/core#definition> "Web-Adresse."@de .


###  https://w3id.org/kdm/wirtschaftszweigschluessel
:wirtschaftszweigschluessel rdf:type owl:DatatypeProperty ;
                            rdfs:domain :Wirtschaftszweig ;
                            rdfs:range xsd:string ;
                            rdfs:label "Wirtschaftszweigschlüssel"@de ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Wirtschaftszweigschlüssel gemäß der Klassifikation der Wirtschaftszweige des Statistischen Bundesamts. Umsetzungshinweis: Die Angabe erfolgt ausschließlich in Ziffern, ohne Trennzeichen. Es sind bis zu 5 Ziffern zulässig."@de .


###  https://w3id.org/kdm/wohnungsinhaber
:wohnungsinhaber rdf:type owl:DatatypeProperty ;
                 rdfs:domain :AnschriftInlandStrassenanschrift ;
                 rdfs:range xsd:string ;
                 rdfs:label "Wohnungsinhaber"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Der Name des Wohnungsinhabers, soweit dies zur Adressierung erforderlich ist. Max Mustermann bei Müller; Max Mustermann c/o Schmidt."@de .


###  https://w3id.org/kdm/zusatzangabenAnschrift
:zusatzangabenAnschrift rdf:type owl:DatatypeProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :AnschriftAusland
                                                    :AnschriftInlandStrassenanschrift
                                                  )
                                    ] ;
                        rdfs:range xsd:string ;
                        rdfs:label "Zusatzangaben"@de ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Es sind Zusatzangaben zur Anschrift anzugeben. Beispiele: Hinterhaus, Gartenhaus."@de .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000017
<http://purl.obolibrary.org/obo/BFO_0000017> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/BFO_0000023
<http://purl.obolibrary.org/obo/BFO_0000023> rdf:type owl:Class .


###  http://www.ontologyrepository.com/CommonCoreOntologies/Agent
<http://www.ontologyrepository.com/CommonCoreOntologies/Agent> rdf:type owl:Class .


###  https://w3id.org/kdm/Anschrift
:Anschrift rdf:type owl:Class ;
           <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anschrift" ;
           rdfs:label "Anschrift"@de ;
           <http://www.w3.org/2004/02/skos/core#definition> "Abstraktes Kerndatenobjekt. Angaben für die Adressierung. Eine Anschrift ist entweder eine Inlands- oder eine Auslandsanschrift."@de .


###  https://w3id.org/kdm/AnschriftAusland
:AnschriftAusland rdf:type owl:Class ;
                  rdfs:subClassOf :Anschrift ;
                  <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anschriftausland" ;
                  rdfs:label "Anschrift Ausland"@de ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Konkretisierierung des Kerndatenobjektes Anschrift. Angaben für die Adressierung im Ausland."@de .


###  https://w3id.org/kdm/AnschriftInland
:AnschriftInland rdf:type owl:Class ;
                 rdfs:subClassOf :Anschrift ;
                 <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anschriftinland" ;
                 rdfs:label "Anschrift Inland"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Konkretisierierung des Kerndatenobjektes Anschrift. Angaben für die Adressierung im Inland. Eine Inlandsanschrift ist entweder eine Straßenanschrift, eine Postfachanschrift oder eine Großempfängeranschrift."@de .


###  https://w3id.org/kdm/AnschriftInlandGrossempfaengeranschrift
:AnschriftInlandGrossempfaengeranschrift rdf:type owl:Class ;
                                         rdfs:subClassOf :AnschriftInland ;
                                         <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anschriftinlandgrossempfaenger" ;
                                         rdfs:label "Anschrift Inland Großempfängeranschrift"@de ;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Konkretisierierung des Kerndatenobjektes Anschrift Inland. Angaben für die Adressierung im Inland, soweit es sich um die Anschrift eines Großempfängers handelt."@de .


###  https://w3id.org/kdm/AnschriftInlandPostfachanschrift
:AnschriftInlandPostfachanschrift rdf:type owl:Class ;
                                  rdfs:subClassOf :AnschriftInland ;
                                  <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anschriftinlandpostfachanschrift" ;
                                  rdfs:label "Anschrift Inland Postfachanschrift"@de ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Konkretisierierung des Kerndatenobjektes Anschrift Inland. Angaben für die Adressierung im Inland, soweit es sich um die Anschrift eines Postfachs handelt."@de .


###  https://w3id.org/kdm/AnschriftInlandStrassenanschrift
:AnschriftInlandStrassenanschrift rdf:type owl:Class ;
                                  rdfs:subClassOf :AnschriftInland ;
                                  <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anschriftinlandstrassenanschrift" ;
                                  rdfs:label "Anschrift Inland Straßenanschrift"@de ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Konkretisierierung des Kerndatenobjektes Anschrift Inland. Angaben für die Adressierung im Inland, soweit es sich um die Anschrift eines Gebäudes handelt."@de .


###  https://w3id.org/kdm/Ansprechpartner
:Ansprechpartner rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                 <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:ansprechpartner" ;
                 rdfs:label "Ansprechpartner"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Rolle, welche das Kerndatenobjekt Natürliche Person einnehmen kann. Angaben zu einem Ansprechpartner, welcher von der handelnden Person in einem konkreten Antrag eines wirtschaftlich Tätigen bzw. in einer konkreten Anzeige eines wirtschaftlich Tätigen benannt wird für Rückfragen seitens der zuständigen Stelle." .


###  https://w3id.org/kdm/Antrag
:Antrag rdf:type owl:Class ;
        <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:antrag" ;
        rdfs:label "Antrag eines wirtschaftlichen Tätigen"@de ;
        <http://www.w3.org/2004/02/skos/core#definition> "Abstraktes Kerndatenobjekt. Mit diesem Kerndatenobjekt wird ein an eine zuständige öffentliche Stelle gerichteter Antrag eines wirtschaftlich Tätigen auf Durchführung eines Verwaltungsverfahrens in eigener Sache gemäß § 9 VwVfG gefasst."@de .


###  https://w3id.org/kdm/Antragsteller
:Antragsteller rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
               <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:antragsteller" ;
               rdfs:label "Antragsteller"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Dies ist ist eine Rolle, welche die Kerndatenobjekte Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft, Sonstige Personenvereinigung und Wirtschaftliche Tätigkeit einnehmen können. Mit dieser Rolle wird die natürliche Person oder juristische Person oder die rechtsfähige Personengesellschaft oder sonstige Personenvereinigung identifiziert, die bei der zuständigen Stelle in eigener Sache den Erlass eines Verwaltungsakts beantragt oder durch einen Vertreter beantragen lässt und so die Durchführung eines Verwaltungsverfahrens im Sinne des § 9 VwVfG veranlasst. Der Antragsteller ist Beteiligter im Verwaltungsverfahren gemäß § 13 VwVfG." .


###  https://w3id.org/kdm/Anzeige
:Anzeige rdf:type owl:Class ;
         <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anzeige" ;
         rdfs:label "Anzeige eines wirtschaftlichen Tätigen"@de ;
         <http://www.w3.org/2004/02/skos/core#definition> "Abstraktes Kerndatenobjekt. Mit diesem Kerndatenobjekt wird eine an die zuständige öffentliche Stelle gerichtete einseitige empfangsbedürftige Willenserklärung eines wirtschaftlich Tätigen in eigener Sache gefasst."@de .


###  https://w3id.org/kdm/Anzeigender
:Anzeigender rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
             <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:anzeigender" ;
             rdfs:label "Anzeigender"@de ;
             <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Rolle, welche die Kerndatenobjekte Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft, Sonstige Personenvereinigung und Wirtschaftliche Tätigkeit einnehmen können. Mit dieser Rolle wird die natürliche Person oder juristische Person oder die rechtsfähige Personengesellschaft oder sonstige Personenvereinigung identifiziert, die bei der zuständigen Stelle in eigener Sache eine Anzeige erstattet oder durch einen Vertreter erstatten lässt." .


###  https://w3id.org/kdm/Beteiligter
:Beteiligter rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
             <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:beteiligtersonstigepersonenvereinigung" ;
             rdfs:label "Beteiligter einer sonstigen Personenvereinigung"@de ;
             <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Rolle, welche das Kerndatenobjekt Natürliche Person einnehmen kann. Mit dieser Rolle wird ein Beteiligter einer sonstigen Personenvereinigung gefasst." .


###  https://w3id.org/kdm/Betriebsstaette
:Betriebsstaette rdf:type owl:Class ;
                 <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:betriebsstaette" ;
                 rdfs:label "Betriebsstätte"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Dieses Kerndatenobjekt identifiziert einen Ort, an welchem eine wirtschaftliche Tätigkeit tatsächlich und grundsätzlich dauerhaft ausgeübt wird."@de .


###  https://w3id.org/kdm/Demail
:Demail rdf:type owl:Class ;
        rdfs:subClassOf :Kommunikation ;
        <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:kommunikation.demail" ;
        rdfs:label "De-Mail"@de ;
        <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Konkretisierierung des Kerndatenobjektes Kommunikation. Angabe einer De-Mail-Adresse."@de .


###  https://w3id.org/kdm/EffektiverVerwaltungssitz
:EffektiverVerwaltungssitz rdf:type owl:Class ;
                           <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:effektiververwaltungssitz" ;
                           rdfs:label "Effektiver Verwaltungssitz"@de ;
                           <http://www.w3.org/2004/02/skos/core#definition> "Der effektiver Verwaltungssitz ist - im Unterschied zum Sitz - der Ort, an dem sich die Hauptverwaltung befindet und die Geschäfte tatsächlich geführt werden."@de .


###  https://w3id.org/kdm/Eintragung
:Eintragung rdf:type owl:Class ;
            <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:eintragung" ;
            rdfs:label "Eintragung"@de ;
            <http://www.w3.org/2004/02/skos/core#definition> "Dieses Kerndatenobjekt fasst die Daten, mit welchen die Eintragung eines wirtschaftlich Tätigen bzw. einer wirtschaftlichen Tätigkeit in einem Handels-, Genossenschafts-,Gesellschafts-, Vereins-, Partnerschafts- oder Stiftungsregister sowie in einem Stiftungsverzeichnis identifiziert werden kann."@de .


###  https://w3id.org/kdm/Email
:Email rdf:type owl:Class ;
       rdfs:subClassOf :Kommunikation ;
       <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:kommunikation.email" ;
       rdfs:label "E-Mail"@de ;
       <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Konkretisierierung des Kerndatenobjektes Kommunikation. Angabe einer E-Mail-Adresse."@de .


###  https://w3id.org/kdm/Geburt
:Geburt rdf:type owl:Class ;
        <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:geburt" ;
        rdfs:label "Geburt"@de ;
        <http://www.w3.org/2004/02/skos/core#definition> "Angaben zur Geburt einer natürlichen Person."@de .


###  https://w3id.org/kdm/Gesellschafter
:Gesellschafter rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:gesellschafter" ;
                rdfs:label "Gesellschafter"@de ;
                <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Rolle, welche die Kerndatenobjekte Natürliche Person, Juristische Person und Rechtsfähige Personengesellschaft einnehmen können. Mit dieser Rolle wird ein Gesellschafter einer rechtsfähigen Personengesellschaft gefasst." .


###  https://w3id.org/kdm/GesetzlicherVertreter
:GesetzlicherVertreter rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                       <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:gesetzlichervertreter" ;
                       rdfs:label "Gesetzlicher Vertreter"@de ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Rolle, welche die Kerndatenobjekte Natürliche Person und Juristische Person einnehmen können. Mit dieser Rolle wird der gesetzliche Vertreter einer juristischen Person oder natürlichen Person gefasst. Es handelt sich hierbei um Vertreter, deren Vertretungsmacht sich allein aus gesetzlichen Bestimmungen ergibt und nicht durch ein Rechtsgeschäft erteilt wurde." .


###  https://w3id.org/kdm/HandelndePerson
:HandelndePerson rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                 <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:handelndeperson" ;
                 rdfs:label "Handelnde Person"@de ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Dies ist eine Rolle, welche das Kerndatenobjekt Natürliche Person einnehmen kann. Mit dieser Rolle wird die natürliche Person identifiziert, die im konkreten Vorgang die Verfahrenshandlungen (beispielsweise einen Antrag stellt oder eine Anzeige einreicht) vornimmt." .


###  https://w3id.org/kdm/JuristischePerson
:JuristischePerson rdf:type owl:Class ;
                   rdfs:subClassOf <http://www.ontologyrepository.com/CommonCoreOntologies/Agent> ;
                   owl:disjointWith :SonstigePersonenvereinigung ;
                   <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:juristischeperson" ;
                   rdfs:label "Juristische Person"@de ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Dieses Kerndatenobjekt umfasst die allgemeinen Angaben zu einer juristischen Person des privaten oder öffentlichen Rechts." .


###  https://w3id.org/kdm/Kommunikation
:Kommunikation rdf:type owl:Class ;
               <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:kommunikation" ;
               rdfs:label "Kommunikation"@de ;
               <http://www.w3.org/2004/02/skos/core#definition> "Abstraktes Kerndatenobjekt. Angaben zu einer elektronischen Erreichbarkeit."@de .


###  https://w3id.org/kdm/NameEinerNatuerlichenPerson
:NameEinerNatuerlichenPerson rdf:type owl:Class ;
                             <http://purl.org/dc/terms/identifier> "urn:xoev-de:xunternehmen:kerndatenobjekt:namenatuerlicheperson" ;
                             rdfs:label "Name einer natürlichen Person"@de ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Datenobjekt zur Darstellung des Namens einer natürlichen Person in lateinischer Schrift, entsprechend der Vorgaben aus dem Baukasten des Föderalen Informationsmanagements (FIM)."@de .


###  https://w3id.org/kdm/NatuerlichePerson
