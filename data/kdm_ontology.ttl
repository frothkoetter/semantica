@base <https://w3id.org/kdm/> .

<https://w3id.org/kdm/> rdf:type owl:Ontology ;
                         owl:versionIRI <https://w3id.org/kdm/> ;
                         <http://purl.org/dc/terms/abstract> "Diese Ontologie ist die Darstellung des semantischen Datenmodells XUnternehmen.Kerndatenmodell."@de ;
                         <http://purl.org/dc/terms/bibliographicCitation> "Rinsche, L.; Strauß, C.; Strupp, A.; Repräsentation des XUnternehmen.Kerndatenmodells als Ontologie (2025)" ;
                         <http://purl.org/dc/terms/created> "2025-09-29"^^xsd:date ;
                         <http://purl.org/dc/terms/creator> "Annika Strupp" ,
                                                            "Cornelia Strauß" ,
                                                            "Ludger Rinsche" ;
                         <http://purl.org/dc/terms/description> "Diese Ontologie ist die formale Repräsentation des XUnternehmen.Kerndatenmodells als Ontologie, auf der Basis der Basic Formal Ontology (BFO)."@de ,
                                                                "This Ontology is the representation of semantic model XUnternehmen.Kerndatenmodell based on Basic Formal Ontology (BFO)."@en ;
                         <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                         <http://purl.org/dc/terms/title> "XUnternehmen.Kerndatenmodell als Ontologie"@de ;
                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "kdm" ;
                         <http://schema.org/codeRepository> "https://gitlab.opencode.de/xunternehmen/kerndatenmodell-ontologie-owl"^^xsd:anyURI ;
                         rdfs:seeAlso <https://www.xrepository.de/details/urn:xoev-de:xunternehmen:standard:basismodul> ;
                         owl:versionInfo "Version 1.2"@de .

