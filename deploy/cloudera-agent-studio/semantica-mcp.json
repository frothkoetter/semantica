{
  "mcpServers": {
    "semantica": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/frothkoetter/semantica.git@main",
        "semantica-mcp"
      ],
      "env": {
        "ALLOW_AGENT_STUDIO_INSECURE_TOOL_EXECUTION": "true",
        "SEMANTICA_KG_PATH": "/home/cdsw/semantica/data/airline_graph.json",
        "SEMANTICA_MAPPING_CONFIG": "/home/cdsw/semantica/config/airline_r2rml_db_mapping.yaml",
        "SEMANTICA_BUSINESS_RULES": "/home/cdsw/semantica/config/airline_business_rules.yaml",
        "SEMANTICA_LOG_LEVEL": "WARNING"
      }
    }
  }
}
