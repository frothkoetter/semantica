# Cloudera Agent Studio — Workflow environment (paste real values at workflow setup)
# Agent Studio does NOT persist MCP env secrets after registration; set them per workflow.
#
# MCP paths: Agent Studio bind-mounts workflow_data at /workflow_data/ inside the MCP sandbox.
# Copy files from the semantica clone into workflow_data on the host first (see README §5):
#   /home/cdsw/agent-studio/studio-data/workflows/<workflow_dir>/workflow_data/data/
#   /home/cdsw/agent-studio/studio-data/workflows/<workflow_dir>/workflow_data/config/
#
#   ✓ SEMANTICA_KG_PATH=/workflow_data/data/airline_graph.json
#   ✗ SEMANTICA_KG_PATH=/home/cdsw/semantica/data/airline_graph.json  (not visible in sandbox)
#   ✗ SEMANTICA_KG_PATH=airline_graph.json                            (resolves under /workspace)

ALLOW_AGENT_STUDIO_INSECURE_TOOL_EXECUTION=true

SEMANTICA_KG_PATH=/workflow_data/data/airline_graph.json
SEMANTICA_MAPPING_CONFIG=/workflow_data/config/airline_r2rml_db_mapping.yaml
SEMANTICA_BUSINESS_RULES=/workflow_data/config/airline_business_rules.yaml
SEMANTICA_LOG_LEVEL=INFO

HIVE_HOST=hs2-cdw-aw-se-hive.dw-se-sandbox-aws.a465-9q4k.cloudera.site
HIVE_PORT=443
HIVE_USER=
HIVE_PASSWORD=
HIVE_DATABASE=airlinedata
HIVE_USE_HTTP_TRANSPORT=true
HIVE_HTTP_PATH=cliservice
HIVE_USE_SSL=true
HIVE_AUTH_MECHANISM=LDAP
