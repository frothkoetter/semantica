    <!-- https://w3id.org/kdm/WirtschaftlichTaetiger -->


    <owl:Class rdf:about="https://w3id.org/kdm/WirtschaftlichTaetiger">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <terms:identifier>urn:xoev-de:xunternehmen:kerndatenobjekt:wirtschaftlichtaetiger</terms:identifier>
        <rdfs:label xml:lang="de">Wirtschaftlich Tätiger</rdfs:label>
        <skos:definition>Dies ist eine Rolle, welche die Kerndatenobjekte Natürliche Person, Juristische Person, Rechtsfähige Personengesellschaft und Sonstige Personenvereinigung einnehmen können. Bezogen #auf eine wirtschaftliche Tätigkeit bezeichnet diese Rolle die nach außen am Wirtschaftsleben teilnehmende Person bzw. Personenvereinigung.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/kdm/WirtschaftlicheTaetigkeit -->


    <owl:Class rdf:about="https://w3id.org/kdm/WirtschaftlicheTaetigkeit">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <terms:identifier>urn:xoev-de:xunternehmen:kerndatenobjekt:wirtschaftlichetaetigkeit</terms:identifier>
        <rdfs:label xml:lang="de">Wirtschaftliche Tätigkeit</rdfs:label>
        <skos:definition xml:lang="de">Das Kerndatenobjekt Wirtschaftliche Tätigkeit umfasst in generischer Weise eine planmäßige, für eine gewisse Dauer bestimmte, selbstständige wirtschaftliche Tätigkeit eines wirtschaftlich Tätigen.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/kdm/Wirtschaftszweig -->


    <owl:Class rdf:about="https://w3id.org/kdm/Wirtschaftszweig">
        <terms:identifier>urn:xoev-de:xunternehmen:kerndatenobjekt:wirtschaftszweig</terms:identifier>
        <rdfs:label xml:lang="de">Wirtschaftszweig</rdfs:label>
        <skos:definition xml:lang="de">Dieses Kerndatenobjekt modelliert die Angabe eines Wirtschaftszweigs gemäß der Klassifikation des statistischen Bundesamts. Es umfasst die Angabe des Wirtschaftszweigschlüssels und der angewendeten Version der Klassifikation.</skos:definition>
    </owl:Class>
</rdf:RDF>



