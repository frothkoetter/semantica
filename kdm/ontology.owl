        <rdfs:label xml:lang="de">Telefax</rdfs:label>
        <skos:definition xml:lang="de">Dies ist eine Konkretisierierung des Kerndatenobjektes Kommunikation. Angabe einer Telefaxnummer.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/kdm/Telefon -->


    <owl:Class rdf:about="https://w3id.org/kdm/Telefon">
