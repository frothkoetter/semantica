    </owl:Class>
    


    <!-- https://w3id.org/kdm/WebAdresse -->


    <owl:Class rdf:about="https://w3id.org/kdm/WebAdresse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/kdm/Kommunikation"/>
