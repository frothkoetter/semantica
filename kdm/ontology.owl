<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/kdm/"
     xml:base="https://w3id.org/kdm/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/kdm/">
        <owl:versionIRI rdf:resource="https://w3id.org/kdm/"/>
        <terms:abstract xml:lang="de">Diese Ontologie ist die Darstellung des semantischen Datenmodells XUnternehmen.Kerndatenmodell.</terms:abstract>
        <terms:bibliographicCitation>Rinsche, L.; Strauß, C.; Strupp, A.; Repräsentation des XUnternehmen.Kerndatenmodells als Ontologie (2025)</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-29</terms:created>
        <terms:creator>Annika Strupp</terms:creator>
        <terms:creator>Cornelia Strauß</terms:creator>
        <terms:creator>Ludger Rinsche</terms:creator>
        <terms:description xml:lang="de">Diese Ontologie ist die formale Repräsentation des XUnternehmen.Kerndatenmodells als Ontologie, auf der Basis der Basic Formal Ontology (BFO).</terms:description>
        <terms:description xml:lang="en">This Ontology is the representation of semantic model XUnternehmen.Kerndatenmodell based on Basic Formal Ontology (BFO).</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="de">XUnternehmen.Kerndatenmodell als Ontologie</terms:title>
        <vann:preferredNamespacePrefix>kdm</vann:preferredNamespacePrefix>
        <schema:codeRepository rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://gitlab.opencode.de/xunternehmen/kerndatenmodell-ontologie-owl</schema:codeRepository>
        <rdfs:seeAlso rdf:resource="https://www.xrepository.de/details/urn:xoev-de:xunternehmen:standard:basismodul"/>
        <owl:versionInfo xml:lang="de">Version 1.2</owl:versionInfo>
    </owl:Ontology>
    


